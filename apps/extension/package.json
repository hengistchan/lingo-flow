{
  "name": "@lingoflow/extension",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:chrome",
    "build:chrome": "wxt build --browser chrome --mv3",
    "build:edge": "wxt build --browser edge --mv3",
    "clean": "wxt clean",
    "compile": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "wxt --mv3",
    "package": "pnpm package:chrome",
    "package:chrome": "pnpm build:chrome && node ../../scripts/package-extension.mjs chrome",
    "package:edge": "pnpm build:edge && node ../../scripts/package-extension.mjs edge"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@vitejs/plugin-vue": "^5.2.4",
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.10",
    "wxt": "^0.20.7"
  }
}
